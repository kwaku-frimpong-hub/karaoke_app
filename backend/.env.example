# Copy to backend/.env and adjust as needed. All values have sensible
# defaults in app/core/config.py; environment variables take precedence.

# Environment: development | test | production
KARAOKE_ENVIRONMENT=development

# Enable debug behavior (e.g. stack traces) during development.
KARAOKE_DEBUG=true

# Log level for the structured JSON logs.
KARAOKE_LOG_LEVEL=INFO

# Async SQLAlchemy database URL. The default matches the dockerized
# PostgreSQL from the repository root compose.yaml.
KARAOKE_DATABASE_URL=postgresql+asyncpg://karaoke:karaoke@localhost:5432/karaoke

# Lifetime of a host bearer token in days (M3). Logout revokes it early.
KARAOKE_AUTH_TOKEN_TTL_DAYS=30

# Public base URL of the frontend, used to build session join URLs (M4).
# Defaults to the Vite dev server; set to the deployed frontend in production.
KARAOKE_PUBLIC_BASE_URL=http://localhost:5173

# YouTube Data API v3 key for fetching song metadata (M6). Create a free key at
# https://console.cloud.google.com/apis/library/youtube.googleapis.com . Leave
# empty for tests (they mock the HTTP call); the preview endpoint returns 503
# when unset.
KARAOKE_YOUTUBE_API_KEY=

# Videos longer than this (seconds) get a warning in the preview (M6, default 10 min).
# Warnings never reject the video.
KARAOKE_YOUTUBE_LONG_VIDEO_SECONDS=600

# Maximum songs a participant may queue total, across all rounds (M10.1, D45).
# Submissions beyond this are rejected with a clear message.
KARAOKE_QUEUE_MAX_SONGS_PER_PARTICIPANT=5

# Default automatic-transition timings in seconds (M13, PRODUCT_SPEC §10).
# Per-session overrides can be set via cooldown_seconds/countdown_seconds on
# session creation.
KARAOKE_POST_SONG_COOLDOWN_SECONDS=10
KARAOKE_NEXT_SINGER_COUNTDOWN_SECONDS=20

# How long a participant may go without connecting (realtime channel) before
# their remaining WAITING songs are cleaned up as absent (M16).
KARAOKE_ABSENT_PARTICIPANT_CLEANUP_SECONDS=1800

# Security (M17): master switch for the in-process rate limits (join/preview/
# submit). Tests set this to false. The YouTube metadata cache TTL protects the
# Data API daily quota from repeated lookups of the same video.
KARAOKE_RATE_LIMITS_ENABLED=true
KARAOKE_YOUTUBE_CACHE_TTL_SECONDS=3600
